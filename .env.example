# 템플릿: cp .env.example .env.local 후 .env.local 에만 실제 값을 채웁니다.
# .env.example 에는 키 이름만 두고 비밀 값은 넣지 마세요.
# .env* 로컬 파일은 Git에 올라가지 않습니다 (.gitignore).
#
# prod 키는 Vercel Settings → Environment Variables 에만 입력하세요.

# --- App environment (local | prod) ---
# local: 로컬 npm run dev (.env.local)
# prod: Vercel Environment Variables 에만 설정 (소스/ Git 에 prod 키 금지)
NEXT_PUBLIC_APP_ENV=local

# --- Amplitude (브라우저 SDK) ---
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_AMPLITUDE_ENABLE_LOGGING=false
NEXT_PUBLIC_AMPLITUDE_SERVER_ZONE=US
# true 시 SDK 비활성화 (Failed to fetch 콘솔 오류 방지)
# NEXT_PUBLIC_AMPLITUDE_DISABLED=true
# true 시 pageViews/sessions 자동 수집 (기본 false)
# NEXT_PUBLIC_AMPLITUDE_AUTOTRACK=true

# --- Amplitude (서버 HTTP API, POST /api/2/httpapi — Amplitude /2/httpapi 와 동일) ---
# 미설정 시 NEXT_PUBLIC_AMPLITUDE_API_KEY 를 사용합니다.
AMPLITUDE_API_KEY=
AMPLITUDE_API_BASE_URL=https://api2.amplitude.com

# --- Braze (Web SDK) — endpoint 는 sdk.* 이어야 합니다 (rest.* 아님) ---
NEXT_PUBLIC_BRAZE_API_KEY=
NEXT_PUBLIC_BRAZE_SDK_ENDPOINT=
NEXT_PUBLIC_BRAZE_ENABLE_LOGGING=false
# 상품상세 추가혜택 Placement ID — Braze Dashboard Placement와 동일하게 설정
# 배너 HTML/디자인은 Dashboard에서 관리 (앱 코드에 템플릿 없음)
NEXT_PUBLIC_BRAZE_BANNER_PDP_BENEFITS_PLACEMENT=pdp_additional_benefit
# 웹 푸시: public/service-worker.js 가 사이트 루트에서 제공되어야 합니다.
# Braze Dashboard → Settings → Push → Web Push 에서 VAPID 키 설정 후 캠페인 발송 가능.

# --- Braze (REST API, POST /api/users/track — Braze /users/track 과 동일) ---
BRAZE_REST_API_KEY=
BRAZE_REST_API_URL=

# --- TechStore Public API (Braze Webhook Campaign · 외부 연동, /api/v1/*) ---
# 설정 시 Authorization: Bearer <key> 또는 X-Api-Key 헤더 필요
TECHSTORE_API_KEY=
# Braze Webhook Campaign 수신 (/api/v1/webhooks/braze) 검증용 (선택)
# Connected Content 쿠폰 PoC (/api/v1/connected-content/coupon)에도 동일 시크릿 사용 가능
BRAZE_WEBHOOK_SECRET=

# --- Talon.One (Integration API, 서버 전용 — /api/v1/talon/*) ---
# Campaign Manager → Application → Settings → Integration API Key
# 값은 .env.local / Vercel에만 넣고 Git에 올리지 마세요.
TALON_ONE_BASE_URL=
TALON_ONE_API_KEY=
TALON_ONE_APPLICATION_ID=
# Loyalty program 생성 후 (optional)
TALON_ONE_LOYALTY_PROGRAM_ID=

# --- Admin API Tester (Braze/Amplitude 프록시) ---
# 회사 VPN·보안 프록시로 Node fetch 가 TLS 오류(fetch failed)일 때만 개발용으로 true
# ADMIN_PROXY_INSECURE_TLS=true
